#!/usr/bin/env bash
#

#
# Node.js Bun
#
export BUN_INSTALL="${HOME}/.local/share/bun"

#
# Node.js NVM
#
export NVM_DIR="${HOME}/.nvm"
if [[ -s "${NVM_DIR}/nvm.sh" ]]
then
    source "${NVM_DIR}/nvm.sh"
fi
if [[ -s "${NVM_DIR}/bash_completion" ]]
then
    source "${NVM_DIR}/bash_completion"
fi

#
# Rust Cargo:
#  - define Rust environmental variables
#
export CARGO_HOME="${HOME}/.local/share/cargo"
export RUSTUP_HOME="${HOME}/.local/share/rustup"

#  - enable Cargo support
#
if [[ -f "${HOME}/.local/share/cargo/env" ]]
then
    source "${HOME}/.local/share/cargo/env"
fi

#
# Python VirtualEnv:
#  - disable the default virtualenv prompt change
#
export VIRTUAL_ENV_DISABLE_PROMPT="1"

#  - some useful environment variables
#
export PROJECT_HOME="${HOME}/projects"
export VIRTUALENVS_PATH="${HOME}/.virtualenvs"

#  - enable VirtualEnvWrapper support
#
export WORKON_HOME="${VIRTUALENVS_PATH}"

__venvs_mngmnt="${VIRTUALENVS_PATH}/__venvs-mngmnt"
export VIRTUALENVWRAPPER_PYTHON="${__venvs_mngmnt}/bin/python"
export VIRTUALENVWRAPPER_VIRTUALENV="${__venvs_mngmnt}/bin/virtualenv"
if [[ -f "${__venvs_mngmnt}/bin/virtualenvwrapper.sh" ]]
then
    source "${__venvs_mngmnt}/bin/virtualenvwrapper.sh"
else
    unset WORKON_HOME

    unset VIRTUALENVWRAPPER_PYTHON
    unset VIRTUALENVWRAPPER_VIRTUALENV
fi

#
# Python Poetry:
#  - enable Poetry support
#
if [[ "$(which poetry)" ]]
then
    export POETRY_VIRTUALENVS_PATH="${VIRTUALENVS_PATH}"
fi

#
# Useful proxy exports
#
# export HTTP_PROXY="http://<address>:<port>"
# export HTTPS_PROXY="http://<address>:<port>"
# export FTP_PROXY="http://<address>:<port>"
# export NO_PROXY="localhost,127.0.0.1,::1"
#
# export http_proxy="${HTTP_PROXY}"
# export https_proxy="${HTTPS_PROXY}"
# export ftp_proxy="${FTP_PROXY}"
# export no_proxy="${NO_PROXY}"

#
# User defined exports
#
export VISUAL="nano"
export EDITOR="${VISUAL}"

# - useful if you're under WSL
#
if [[ -n "${IS_WSL_ENV}" ]]
then
    export BROWSER="none"
    export WINDOWS_HOME="/mnt/c/Users/<username>"
fi
